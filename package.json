{
  "name": "ttv-short-drama-frontend",
  "private": true,
  "version": "0.2.32",
  "description": "TTV Short Drama — Windows 11 Mica 风格短剧/漫剧桌面播放器前端（React + TypeScript + Vite，配套 Tauri/Rust 后端位于 src-tauri/）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:boost": "node --experimental-strip-types scripts/verify-boost.mjs",
    "verify:tail": "node --experimental-strip-types scripts/verify-playback-tail.mjs",
    "verify:random-pick": "node --experimental-strip-types scripts/verify-random-pick.mjs",
    "verify:launch-overlay": "node --experimental-strip-types scripts/verify-launch-overlay.ts",
    "verify:keyrepeat": "node --experimental-strip-types scripts/verify-keyrepeat.ts",
    "verify:player-toast-dom": "node --experimental-strip-types scripts/verify-player-toast-dom.ts",
    "verify:player-toast": "node --experimental-strip-types scripts/verify-player-toast.ts",
    "verify:resume": "node --experimental-strip-types scripts/verify-resume.ts",
    "verify:start": "node --experimental-strip-types scripts/verify-start-position.mjs",
    "verify:seek": "node --experimental-strip-types scripts/verify-seek-plan.mjs",
    "verify:season-label": "node --experimental-strip-types scripts/verify-season-label.mjs",
    "verify:related-section": "node scripts/verify-related-section.mjs",
    "verify:related-pick": "node scripts/verify-related-pick.mjs",
    "verify:related-batch": "node scripts/verify-related-batch.mjs",
    "verify:season-priority": "node scripts/verify-season-priority.mjs",
    "watch:playback": "node scripts/watch-playback.mjs",
    "tauri": "tauri",
    "verify:buffer-rate": "node scripts/verify-buffer-rate.mjs",
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-integrity.ps1",
    "prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-integrity.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
